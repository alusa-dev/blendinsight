# Local only. Do not copy production values into a development environment.
NODE_ENV=development
MCP_PUBLIC_URL=http://localhost:3000
DATABASE_URL=
DATABASE_URL_UNPOOLED=
MIGRATION_DATABASE_URL=
NEON_BRANCH=development
TOKEN_ENCRYPTION_KEY=

# Meta app credentials. Configure OAuth redirect URLs in the Meta dashboard
# to exactly match the URLs derived from MCP_PUBLIC_URL.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0

# Optional. Defaults to all supported, current Instagram Login permissions.
INSTAGRAM_LOGIN_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_messages,instagram_business_manage_insights
FACEBOOK_LOGIN_SCOPES=instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_messages,instagram_manage_insights,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_metadata,instagram_manage_engagement,instagram_manage_contents
# Optional; leave empty unless your Meta app has the product and approved access.
# This can include catalog/product-tagging, creator discovery, partnership ads,
# Ads API, and Instagram reminder-event permissions.
FACEBOOK_LOGIN_OPTIONAL_SCOPES=
